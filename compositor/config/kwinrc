# LUMEN OS — KWin defaults (/etc/xdg/kwinrc). Users can override in ~/.config.
[org.kde.kdecoration2]
library=org.lumen.decoration
theme=
ButtonsOnLeft=XIA
ButtonsOnRight=
BorderSize=None
BorderSizeAuto=false

[Plugins]
blurEnabled=true
contrastEnabled=true
lumen_windowsEnabled=true
lumen_gesturesEnabled=true
lumen_glassEnabled=true
overviewEnabled=true
windowviewEnabled=true
slideEnabled=true
scaleEnabled=false
glideEnabled=false
fadeEnabled=false
magiclampEnabled=false
squashEnabled=false
dimscreenEnabled=true
shakecursorEnabled=true

[Effect-blur]
BlurStrength=12
NoiseStrength=2

[Effect-slide]
HorizontalGap=40
SlideBackground=false
SlideDocks=false

[Effect-overview]
BorderActivate=9
TouchBorderActivate=9

[TabBox]
LayoutName=lumen-switcher
ApplicationsMode=1
ShowDesktopMode=0
HighlightWindows=false
OrderMinimizedMode=0

[Desktops]
Number=3
Rows=1
Name_1=Desktop 1
Name_2=Desktop 2
Name_3=Desktop 3

[Windows]
BorderlessMaximizedWindows=false
Placement=Centered
FocusStealingPreventionLevel=1
ElectricBorderMaximize=true
ElectricBorderTiling=true

[Compositing]
LatencyPolicy=Low
AllowTearing=false

[NightColor]
Active=false
Mode=Automatic

[Xwayland]
Scale=1
