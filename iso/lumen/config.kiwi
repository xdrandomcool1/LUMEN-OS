<?xml version="1.0" encoding="utf-8"?>
<!-- LUMEN OS 1.0 — live + installer ISO (UEFI, Secure Boot via shim). -->
<image schemaversion="7.6" name="LUMEN-OS">
    <description type="system">
        <author>LUMEN OS</author>
        <contact>noreply@lumen-os.invalid</contact>
        <specification>LUMEN OS 1.0 live system with the Calamares installer</specification>
    </description>
    <preferences>
        <version>1.0.0</version>
        <packagemanager>dnf5</packagemanager>
        <locale>en_US</locale>
        <keytable>us</keytable>
        <timezone>UTC</timezone>
        <rpm-excludedocs>true</rpm-excludedocs>
        <rpm-check-signatures>true</rpm-check-signatures>
        <bootsplash-theme>lumen</bootsplash-theme>
        <type image="iso" primary="true" flags="dmsquash" firmware="uefi"
              volid="LUMEN-OS-1_0" publisher="LUMEN OS" mediacheck="false"
              kernelcmdline="rhgb quiet rd.live.image">
            <bootloader name="grub2" console="gfxterm" timeout="5"/>
        </type>
    </preferences>
    <users>
        <user password="" pwdformat="plain" name="liveuser" home="/home/liveuser" groups="wheel" realname="LUMEN Live"/>
    </users>
    <!-- Fedora packages are verified with Fedora's GPG keys (rpm-check-signatures). -->
    <repository type="rpm-md" alias="fedora" priority="10" sourcetype="metalink" package_gpgcheck="true" customize="/src/iso/lumen/repo-customize.sh">
        <source path="https://mirrors.fedoraproject.org/metalink?repo=fedora-45&amp;arch=x86_64">
            <signing key="file:///usr/share/pki/rpm-gpg/RPM-GPG-KEY-fedora-45-primary"/>
        </source>
    </repository>
    <repository type="rpm-md" alias="updates" priority="5" sourcetype="metalink" package_gpgcheck="true" customize="/src/iso/lumen/repo-customize.sh">
        <source path="https://mirrors.fedoraproject.org/metalink?repo=updates-released-f45&amp;arch=x86_64">
            <signing key="file:///usr/share/pki/rpm-gpg/RPM-GPG-KEY-fedora-45-primary"/>
        </source>
    </repository>
    <!-- Locally built LUMEN packages (scripts/build-rpms.sh). -->
    <repository type="rpm-md" alias="lumen" priority="1" package_gpgcheck="false">
        <source path="dir:///repo"/>
    </repository>
    <packages type="image">
        <!-- Base system, kernel, firmware, boot -->
        <package name="kernel"/>
        <package name="kernel-modules-extra"/>
        <package name="linux-firmware"/>
        <package name="microcode_ctl"/>
        <package name="dracut-live"/>
        <package name="grub2-efi-x64"/>
        <package name="grub2-efi-x64-cdboot"/>
        <package name="grub2-tools-extra"/>
        <package name="shim-x64"/>
        <package name="efibootmgr"/>
        <package name="systemd"/>
        <package name="sudo"/>
        <package name="bash-completion"/>
        <package name="vim-minimal"/>
        <package name="glibc-langpack-en"/>
        <package name="btrfs-progs"/>
        <package name="xfsprogs"/>
        <package name="e2fsprogs"/>
        <package name="cryptsetup"/>
        <package name="udisks2"/>
        <!-- Graphics (Intel/AMD via Mesa; NVIDIA via nouveau, proprietary driver optional) -->
        <package name="mesa-dri-drivers"/>
        <package name="mesa-vulkan-drivers"/>
        <package name="mesa-va-drivers"/>
        <package name="xorg-x11-server-Xwayland"/>
        <!-- Networking, audio, bluetooth, power -->
        <package name="NetworkManager-wifi"/>
        <package name="NetworkManager-bluetooth"/>
        <package name="NetworkManager-openvpn"/>
        <package name="wpa_supplicant"/>
        <package name="bluez"/>
        <package name="pipewire-pulseaudio"/>
        <package name="wireplumber"/>
        <package name="power-profiles-daemon"/>
        <package name="upower"/>
        <package name="firewalld"/>
        <!-- Desktop -->
        <package name="lumen-desktop"/>
        <package name="lumen-apps"/>
        <package name="lumen-installer"/>
        <package name="sddm"/>
        <package name="sddm-wayland-plasma"/>
        <package name="plymouth-plugin-script"/>
        <package name="kde-gtk-config"/>
        <package name="breeze-gtk"/>
        <package name="breeze-cursor-theme"/>
        <package name="google-noto-sans-fonts"/>
        <package name="google-noto-color-emoji-fonts"/>
        <package name="google-noto-sans-cjk-fonts"/>
        <package name="firefox"/>
        <package name="flatpak"/>
        <package name="ffmpeg-free"/>
        <package name="calamares"/>
    </packages>
    <packages type="bootstrap">
        <package name="filesystem"/>
        <package name="basesystem"/>
        <package name="fedora-release"/>
        <package name="fedora-repos"/>
        <package name="dnf5"/>
        <package name="rpm"/>
        <package name="glibc-all-langpacks"/>
        <package name="ca-certificates"/>
    </packages>
</image>
