#!/bin/sh
# SPDX-License-Identifier: GPL-3.0-or-later
# LUMEN session entry point (launched by SDDM via lumen.desktop).
#
# LUMEN reuses Plasma's session infrastructure (ksmserver, kded, polkit agent,
# PowerDevil, portals, kscreen) through startplasma-wayland, and replaces the
# Plasma shell with lumen-shell. The swap is done with systemd ExecCondition
# drop-ins keyed on XDG_CURRENT_DESKTOP (see lumen-session.conf).
export XDG_CURRENT_DESKTOP=LUMEN:KDE
export XDG_SESSION_DESKTOP=LUMEN
export DESKTOP_SESSION=lumen
export LUMEN_SESSION=1
export QT_QPA_PLATFORMTHEME=kde
export QT_QUICK_CONTROLS_STYLE=org.kde.desktop
# Smooth GPU scheduling hints for NVIDIA (no effect on other vendors).
export __GL_MaxFramesAllowed=1
exec /usr/bin/startplasma-wayland "$@"
